{#
	teammates.twig

	Renders a list of team members ("mates"). On the team page, alumni
	get a collapsible section; every other category is a flat grid.
#}

<section
	style="margin-bottom: 8rem; grid-column-gap: 40px;"
	class="grid grid--auto grid--gap-40">
	{% if category == "alumni" %}
		<section class="past-interns-spacing">
			<div class="past-interns-title past-interns-title__alumni" data-toggle-arrow="&#9658;" role="button" tabindex="0" aria-expanded="false">
				Alumni
			</div>
			<section class="mates grid grid--gap-20 past-interns-list past-interns-list__alumni" aria-hidden="true">
				{% for mate in mates %}
					{% include "partial/teammate.twig" with { 'mate' : mate, 'category' : category } %}
				{% endfor %}
			</section>
		</section>
	{% else %}
		{% for mate in mates %}
			{% include "partial/teammate.twig" with { 'mate' : mate, 'category' : category } %}
		{% endfor %}
	{% endif %}
</section>
