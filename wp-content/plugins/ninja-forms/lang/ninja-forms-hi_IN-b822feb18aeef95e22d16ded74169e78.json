u093f\u0930\u094d\u092f\u093e\u0924 \u092a\u094d\u0930\u094b\u0938\u0947\u0938 \u0915\u093f\u092f\u093e \u0917\u092f\u093e"],"Export Aborted":["\u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0930\u0926\u094d\u0926 \u0915\u093f\u092f\u093e \u0917\u092f\u093e"],"Reopen to allow new bulk export process":["\u0928\u0908 \u0938\u093e\u092e\u0942\u0939\u093f\u0915 \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092b\u093f\u0930 \u0938\u0947 \u0916\u094b\u0932\u0947\u0902"],"Open details and editing interface for submission %d":["\u0938\u092c\u092e\u093f\u0936\u0928 %d \u0915\u093e \u0935\u093f\u0935\u0930\u0923 \u0914\u0930 \u090f\u0921\u093f\u091f \u0907\u0902\u091f\u0930\u092b\u093c\u0947\u0938 \u0916\u094b\u0932\u0947\u0902"],"button: open the submission to view it (verb)\u0004Open":["\u0916\u094b\u0932\u0947\u0902"],"Close":["\u092c\u0902\u0926 \u0915\u0930\u0947\u0902"],"Only Submissions processed via Ninja Forms can be edited at the moment.":["\u092b\u093c\u093f\u0932\u0939\u093e\u0932 \u0915\u0947\u0935\u0932 Ninja Forms \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092a\u094d\u0930\u094b\u0938\u0947\u0938 \u0915\u093f\u090f \u0917\u090f \u0938\u092c\u092e\u093f\u0936\u0928 \u0939\u0940 \u090f\u0921\u093f\u091f \u0915\u093f\u090f \u091c\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"],"Fieldset %d":["\u092b\u093c\u0940\u0932\u094d\u0921\u0938\u0947\u091f %d"],"No values entered in this field":["\u0907\u0938 \u092b\u093c\u0940\u0932\u094d\u0921 \u092e\u0947\u0902 \u0915\u094b\u0908 \u092e\u093e\u0928 \u0926\u0930\u094d\u091c \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0917\u092f\u093e"],"File Upload Link %s":["\u092b\u093c\u093e\u0907\u0932 \u0905\u092a\u0932\u094b\u0921 \u0932\u093f\u0902\u0915 %s"],"Submission's meta data":["\u0938\u092c\u092e\u093f\u0936\u0928 \u0915\u093e \u092e\u0947\u091f\u093e \u0921\u0947\u091f\u093e"],"Link to the post editing page for submission %d":["\u0938\u092c\u092e\u093f\u0936\u0928 %d \u0915\u0947 \u092a\u094b\u0938\u094d\u091f \u090f\u0921\u093f\u091f \u092a\u0943\u0937\u094d\u0920 \u0915\u093e \u0932\u093f\u0902\u0915"],"Submission Key":["\u0938\u092c\u092e\u093f\u0936\u0928 \u0915\u0941\u0902\u091c\u0940"],"Submitted at":["\u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u093f\u090f \u091c\u093e\u0928\u0947 \u0915\u093e \u0938\u092e\u092f"],"Original Form ID":["\u092e\u0942\u0932 \u092b\u093c\u0949\u0930\u094d\u092e \u0906\u0908\u0921\u0940"],"Loading Form":["\u092b\u093c\u0949\u0930\u094d\u092e \u0932\u094b\u0921 \u0939\u094b \u0930\u0939\u093e \u0939\u0948"],"This form has no submissions.":["\u0907\u0938 \u092b\u093c\u0949\u0930\u094d\u092e \u092e\u0947\u0902 \u0915\u094b\u0908 \u0938\u092c\u092e\u093f\u0936\u0928 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"],"%d submission in the form":["\u092b\u093c\u0949\u0930\u094d\u092e \u092e\u0947\u0902 %d \u0938\u092c\u092e\u093f\u0936\u0928","\u092b\u093c\u0949\u0930\u094d\u092e \u092e\u0947\u0902 %d \u0938\u092c\u092e\u093f\u0936\u0928"],"%d submission filtered":["%d \u0938\u092c\u092e\u093f\u0936\u0928 \u092b\u093c\u093f\u0932\u094d\u091f\u0930 \u0915\u093f\u092f\u093e \u0917\u092f\u093e","%d \u0938\u092c\u092e\u093f\u0936\u0928 \u092b\u093c\u093f\u0932\u094d\u091f\u0930 \u0915\u093f\u090f \u0917\u090f"],"Navigate to first page":["\u092a\u0939\u0932\u0947 \u092a\u0943\u0937\u094d\u0920 \u092a\u0930 \u091c\u093e\u090f\u0901"],"Navigate to previous page":["\u092a\u093f\u091b\u0932\u0947 \u092a\u0943\u0937\u094d\u0920 \u092a\u0930 \u091c\u093e\u090f\u0901"],"Navigate to next page":["\u0905\u0917\u0932\u0947 \u092a\u0943\u0937\u094d\u0920 \u092a\u0930 \u091c\u093e\u090f\u0901"],"Navigate to last page":["\u0905\u0902\u0924\u093f\u092e \u092a\u0943\u0937\u094d\u0920 \u092a\u0930 \u091c\u093e\u090f\u0901"],"Page %1$d of %2$d":["%2$d \u092e\u0947\u0902 \u0938\u0947 \u092a\u0943\u0937\u094d\u0920 %1$d"],"Go to page:":["\u092a\u0943\u0937\u094d\u0920 \u092a\u0930 \u091c\u093e\u090f\u0901:"],"Select the page number to navigate to":["\u0909\u0938 \u092a\u0943\u0937\u094d\u0920 \u0938\u0902\u0916\u094d\u092f\u093e \u0915\u094b \u091a\u0941\u0928\u0947\u0902 \u091c\u093f\u0938 \u092a\u0930 \u091c\u093e\u0928\u093e \u0939\u0948"],"Set number of submissions to display per page.":["\u092a\u094d\u0930\u0924\u093f \u092a\u0943\u0937\u094d\u0920 \u0926\u093f\u0916\u093e\u090f \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u0938\u092c\u092e\u093f\u0936\u0928 \u0915\u0940 \u0938\u0902\u0916\u094d\u092f\u093e \u0938\u0947\u091f \u0915\u0930\u0947\u0902\u0964"],"Show %d":["%d \u0926\u093f\u0916\u093e\u090f\u0901"],"Display Columns control":["\u0915\u0949\u0932\u092e \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923"],"Unselect to hide corresponding column":["\u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0915\u0949\u0932\u092e \u091b\u093f\u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u0928\u091a\u0947\u0915 \u0915\u0930\u0947\u0902"],"No Submissions matching the request.":["\u0905\u0928\u0941\u0930\u094b\u0927 \u0938\u0947 \u092e\u0947\u0932 \u0916\u093e\u0924\u093e \u0915\u094b\u0908 \u0938\u092c\u092e\u093f\u0936\u0928 \u0928\u0939\u0940\u0902\u0964"],"Submissions Status":["\u0938\u092c\u092e\u093f\u0936\u0928 \u0938\u094d\u0925\u093f\u0924\u093f"],"Enter Search Term...":["\u0916\u094b\u091c \u0936\u092c\u094d\u0926 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u2026"],"Filter Submissions":["\u0938\u092c\u092e\u093f\u0936\u0928 \u092b\u093c\u093f\u0932\u094d\u091f\u0930 \u0915\u0930\u0947\u0902"],"Reset Filters":["\u092b\u093c\u093f\u0932\u094d\u091f\u0930 \u0930\u0940\u0938\u0947\u091f \u0915\u0930\u0947\u0902"],"Submission successfully exported":["\u0938\u092c\u092e\u093f\u0936\u0928 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e"],"The export failed. Contact a developer or check the logs if this failure persists.":["\u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0935\u093f\u092b\u0932 \u0930\u0939\u093e\u0964 \u092f\u0926\u093f \u092f\u0939 \u0935\u093f\u092b\u0932\u0924\u093e \u092c\u0928\u0940 \u0930\u0939\u0924\u0940 \u0939\u0948 \u0924\u094b \u0921\u0947\u0935\u0932\u092a\u0930 \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902 \u092f\u093e \u0932\u0949\u0917 \u091c\u093e\u0901\u091a\u0947\u0902\u0964"],"Export submission %d via CSV file":["\u0938\u092c\u092e\u093f\u0936\u0928 %d \u0915\u094b CSV \u092b\u093c\u093e\u0907\u0932 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u0930\u0947\u0902"],"Move submission %d to the Trash":["\u0938\u092c\u092e\u093f\u0936\u0928 %d \u0915\u094b \u091f\u094d\u0930\u0948\u0936 \u092e\u0947\u0902 \u0932\u0947 \u091c\u093e\u090f\u0901"],"Delete Submission %d":["\u0938\u092c\u092e\u093f\u0936\u0928 %d \u0939\u091f\u093e\u090f\u0901"],"Delete Submission Permanently":["\u0938\u092c\u092e\u093f\u0936\u0928 \u0938\u094d\u0925\u093e\u092f\u0940 \u0930\u0942\u092a \u0938\u0947 \u0939\u091f\u093e\u090f\u0901"],"Restore submission %d":["\u0938\u092c\u092e\u093f\u0936\u0928 %d \u092a\u0941\u0928\u0930\u094d\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902"]}}}